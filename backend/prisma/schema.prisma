generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    Int              @id @default(autoincrement())
  email                 String           @unique @db.VarChar(255)
  passwordHash          String?          @map("password_hash") @db.VarChar(255)
  fullName              String           @map("full_name") @db.VarChar(200)
  phone                 String?          @db.VarChar(20)
  birthDate             DateTime?        @map("birth_date") @db.Date
  city                  String?          @db.VarChar(100)
  heightCm              Int?             @map("height_cm")
  weightKg              Decimal?         @map("weight_kg") @db.Decimal(5, 2)
  ridingExperience      String?          @map("riding_experience") @db.VarChar(20)
  monthlyMileage        Int?             @map("monthly_mileage")
  preferredBrands       String[]         @map("preferred_brands")
  budgetRange           Json?            @map("budget_range")
  monthlyIncome         Decimal?         @map("monthly_income") @db.Decimal(15, 2)
  isActive              Boolean          @default(true) @map("is_active")
  lastLogin             DateTime?        @map("last_login")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  emailVerified         Boolean          @default(false) @map("email_verified")
  verificationExpiresAt DateTime?        @map("verification_expires_at")
  verificationToken     String?          @unique @map("verification_token")
  resetPasswordToken    String?          @unique @map("reset_password_token")
  resetPasswordExpiresAt DateTime?       @map("reset_password_expires_at")
  questionnaires        Questionnaire[]
  recommendations       Recommendation[]
  favorites             Favorite[]
  comparisons           Comparison[]
  costSimulations       CostSimulation[]
  reviews               Review[]
  shareEvents           ShareEvent[]
  feedbacks             Feedback[]
  priceAlerts           PriceAlert[]
  notificationHistory   NotificationHistory[]

  @@map("users")
}

model Motorcycle {
  id                    Int              @id @default(autoincrement())
  brand                 String           @db.VarChar(50)
  model                 String           @db.VarChar(100)
  year                  Int?
  engineCc              Int?             @map("engine_cc")
  engineType            String?          @map("engine_type") @db.VarChar(50)
  powerHp               Decimal?         @map("power_hp") @db.Decimal(6, 2)
  torqueNm              Decimal?         @map("torque_nm") @db.Decimal(6, 2)
  weightKg              Decimal?         @map("weight_kg") @db.Decimal(8, 2)
  seatHeightCm          Int?             @map("seat_height_cm")
  fuelType              String?          @map("fuel_type") @db.VarChar(30)
  fuelTankLiters        Decimal?         @map("fuel_tank_liters") @db.Decimal(5, 2)
  consumptionKmpl       Decimal?         @map("consumption_kmpl") @db.Decimal(5, 2)
  transmission          String?          @db.VarChar(30)
  brakeSystem           String?          @map("brake_system") @db.VarChar(50)
  price                 Decimal?         @db.Decimal(12, 2)
  currency              String?          @default("COP") @db.VarChar(10)
  soatEstimated         Decimal?         @map("soat_estimated") @db.Decimal(10, 2)
  registrationEstimated Decimal?         @map("registration_estimated") @db.Decimal(10, 2)
  imageUrl              String?          @map("image_url")
  galleryImages         Json?            @map("gallery_images")
  referencesYT          Json?            @map("references_yt")
  description           String?
  advantages            String[]
  disadvantages         String[]
  source                String?          @db.VarChar(50)
  externalIds           Json?            @map("external_ids")
  lastApiUpdate         DateTime?        @map("last_api_update")
  isActive              Boolean          @default(true) @map("is_active")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  colors                String[]         @default([])
  countryOrigin         String?          @map("country_origin") @db.VarChar(100)
  warranty              String?          @db.VarChar(200)
  recommendations       Recommendation[]
  favorites             Favorite[]
  costSimulations       CostSimulation[]
  reviews               Review[]
  priceAlerts           PriceAlert[]
  notificationHistory   NotificationHistory[]

  @@index([brand, model], map: "idx_motorcycles_brand_model")
  @@map("motorcycles")
}

model Favorite {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  motorcycleId Int        @map("motorcycle_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)

  @@unique([userId, motorcycleId], name: "unique_user_motorcycle_favorite")
  @@index([userId], map: "idx_favorites_user_id")
  @@map("favorites")
}

model Questionnaire {
  id                   Int              @id @default(autoincrement())
  userId               Int?             @map("user_id")
  budget               Decimal          @db.Decimal(12, 2)
  includesSoat         Boolean          @default(false) @map("includes_soat")
  includesRegistration Boolean          @default(false) @map("includes_registration")
  usageType            String           @map("usage_type") @db.VarChar(30)
  frequency            String?          @db.VarChar(30)
  hasPassenger         Boolean          @default(false) @map("has_passenger")
  passengerFrequency   String?          @map("passenger_frequency") @db.VarChar(20)
  heightCm             Int              @map("height_cm")
  weightKg             Decimal?         @map("weight_kg") @db.Decimal(5, 2)
  comfortWithHeavy     Boolean?         @map("comfort_with_heavy")
  recommendationIds    Int[]            @map("recommendation_ids")
  completedAt          DateTime         @default(now()) @map("completed_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  user                 User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations      Recommendation[]
  feedbacks            Feedback[]

  @@map("questionnaires")
}

model Recommendation {
  id                 Int            @id @default(autoincrement())
  userId             Int?           @map("user_id")
  motorcycleId       Int?           @map("motorcycle_id")
  compatibilityScore Int            @map("compatibility_score")
  questionnaireId    Int?           @map("questionnaire_id")
  reasons            Json           @default("[]")
  warnings           String[]       @default([])
  isSaved            Boolean        @default(false) @map("is_saved")
  viewedAt           DateTime?      @map("viewed_at")
  savedAt            DateTime?      @map("saved_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  motorcycle         Motorcycle?    @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)
  questionnaire      Questionnaire? @relation(fields: [questionnaireId], references: [id])
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, motorcycleId, questionnaireId], name: "unique_recommendation")
  @@map("recommendations")
}

model Comparison {
  id             Int        @id @default(autoincrement())
  userId         Int        @map("user_id")
  bikeId1        Int        @map("bike_id_1")
  bikeId2        Int?       @map("bike_id_2")
  bikeId3        Int?       @map("bike_id_3")
  comparisonDate DateTime   @default(now()) @map("comparison_date")
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_comparisons_user_id")
  @@map("comparisons")
}

model CostSimulation {
  id                    Int        @id @default(autoincrement())
  userId                Int?       @map("user_id")
  motorcycleId          Int        @map("motorcycle_id")
  motorPrice            Decimal    @map("motor_price") @db.Decimal(12, 2)
  soatCost              Decimal    @map("soat_cost") @db.Decimal(10, 2)
  registrationCost      Decimal    @map("registration_cost") @db.Decimal(10, 2)
  vehicleTaxCost        Decimal    @map("vehicle_tax_cost") @db.Decimal(10, 2)
  managementCost        Decimal    @default(150000) @map("management_cost") @db.Decimal(10, 2)
  totalCost             Decimal    @map("total_cost") @db.Decimal(12, 2)
  budgetExceeded        Boolean    @default(false) @map("budget_exceeded")
  budgetExceededPercent Int?       @map("budget_exceeded_percent")
  userEditedValues      Json?      @map("user_edited_values") // Almacenar qué valores editó el usuario
  savedAt               DateTime   @default(now()) @map("saved_at")
  user                  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  motorcycle            Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_cost_simulations_user_id")
  @@index([motorcycleId], map: "idx_cost_simulations_motorcycle_id")
  @@map("cost_simulations")
}

model ShareEvent {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  channel      String   @default("whatsapp") @db.VarChar(30)
  source       String   @db.VarChar(50)
  itemCount    Int?     @map("item_count")
  messageLength Int?    @map("message_length")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_share_events_user_id")
  @@index([source], map: "idx_share_events_source")
  @@map("share_events")
}

model Feedback {
  id                    Int         @id @default(autoincrement())
  userId                Int         @map("user_id")
  questionnaireId       Int         @map("questionnaire_id")
  recommendationSignature String    @map("recommendation_signature") @db.VarChar(255)
  isUseful              Boolean     @map("is_useful")
  improvement           String?     @db.VarChar(200)
  createdAt             DateTime    @default(now()) @map("created_at")
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionnaire         Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([userId, questionnaireId, recommendationSignature], name: "unique_feedback_per_generation")
  @@index([userId], map: "idx_feedback_user_id")
  @@index([questionnaireId], map: "idx_feedback_questionnaire_id")
  @@map("feedback")
}

model Review {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  motorcycleId Int        @map("motorcycle_id")
  rating       Int
  comment      String     @db.VarChar(500)
  isVisible    Boolean    @default(true) @map("is_visible")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)

  @@unique([userId, motorcycleId], name: "unique_user_motorcycle_review")
  @@index([motorcycleId], map: "idx_reviews_motorcycle_id")
  @@index([userId], map: "idx_reviews_user_id")
  @@map("reviews")
}

enum NotificationType {
  EMAIL
  IN_APP
  BOTH
}

enum AlertStatus {
  ACTIVE
  PAUSED
  DELETED
}

model PriceAlert {
  id               Int              @id @default(autoincrement())
  userId           Int              @map("user_id")
  motorcycleId     Int              @map("motorcycle_id")
  targetPrice      Decimal          @map("target_price") @db.Decimal(12, 2)
  notificationType NotificationType @default(BOTH) @map("notification_type")
  status           AlertStatus      @default(ACTIVE)
  lastNotifiedAt   DateTime?        @map("last_notified_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  motorcycle       Motorcycle       @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)
  notifications    NotificationHistory[]

  // Restricción única para evitar múltiples alertas activas/duplicadas sobre la misma moto al mismo precio
  @@unique([userId, motorcycleId, targetPrice, status], name: "unique_alert_per_user_moto")

  // Índices para escalabilidad
  @@index([status, lastNotifiedAt], map: "idx_pricealerts_status_notified") // Crítico para Cron Job y Cooldown
  @@index([userId, status], map: "idx_pricealerts_user_status") // Crítico para Panel Mis Alertas y Dashboard
  @@index([motorcycleId, status], map: "idx_pricealerts_motorcycle_status") // Útil para Analytics (Ej. "100 personas esperan que baje YAMAHA")
  @@map("price_alerts")
}

model NotificationHistory {
  id               Int              @id @default(autoincrement())
  userId           Int              @map("user_id")
  alertId          Int              @map("alert_id")
  motorcycleId     Int              @map("motorcycle_id")
  previousPrice    Decimal          @map("previous_price") @db.Decimal(12, 2)
  newPrice         Decimal          @map("new_price") @db.Decimal(12, 2)
  type             NotificationType
  isRead           Boolean          @default(false) @map("is_read")
  sentAt           DateTime         @default(now()) @map("sent_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert            PriceAlert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  motorcycle       Motorcycle       @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)

  // Índices para historial y notificaciones
  @@index([alertId, sentAt], map: "idx_notifications_alert_sentat") // Crítico para validar cooldown (Anti-spam) en el cron job
  @@index([userId, isRead], map: "idx_notifications_user_read") // Crítico para Listados de notificaciones "In-App" (No leídas)
  @@map("notification_history")
}
